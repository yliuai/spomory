{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.lyf-wxy/spomory",
  "description": "Explainable graph-retrieval memory engine with an RL-trained management policy.",
  "repository": {
    "url": "https://github.com/yliuai/spomory",
    "source": "github"
  },
  "version": "0.2.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "spomory",
      "version": "0.2.1",
      "registryBaseUrl": "https://pypi.org",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        { "type": "named", "name": "--from", "value": "spomory[mcp]" },
        { "type": "positional", "value": "spomory-mcp" }
      ],
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "LLM_API_KEY",
          "description": "API key for an OpenAI-compatible LLM provider, used for entity/relation extraction",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "LLM_BASE_URL",
          "description": "OpenAI-compatible base URL",
          "isRequired": false,
          "default": "https://api.openai.com/v1"
        },
        {
          "name": "LLM_MODEL",
          "description": "Model name for extraction",
          "isRequired": false,
          "default": "gpt-4o-mini"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.yliuai.com/mcp"
    },
    {
      "type": "streamable-http",
      "url": "https://api.yliuai.com/mcp-apikey",
      "headers": [
        { "name": "x-api-key", "description": "API key from POST /users/register", "isRequired": true, "isSecret": true }
      ]
    }
  ]
}
